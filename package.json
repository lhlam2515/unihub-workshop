{
  "name": "unihub-workshop",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=!web",
    "dev:server": "turbo run dev --filter=server",
    "dev:web": "turbo run dev --filter=!mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "check-types": "turbo run check-types",
    "check": "turbo run check",
    "format": "turbo run format",
    "prepare": "husky",
    "postinstall": "pnpm --filter=@repo/agent-config run sync",
    "agent-config:sync": "pnpm --filter=@repo/agent-config run sync",
    "agent-config:check": "pnpm --filter=@repo/agent-config run check",
    "db:seed": "pnpm --filter=server db:seed",
    "test:e2e": "pnpm --filter=web test:e2e"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  }
}
