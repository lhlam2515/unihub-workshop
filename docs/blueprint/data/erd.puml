@startuml UniHub_Workshop_ERD
!theme plain
skinparam linetype ortho
skinparam roundcorner 8
skinparam classFontSize 11
skinparam classAttributeFontSize 10
skinparam packageStyle rectangle
skinparam shadowing false

' ============================================================
' COLOR SCHEME PER BOUNDED CONTEXT
' ============================================================
skinparam class {
    BackgroundColor<<Identity>>     #DDEEFF
    BorderColor<<Identity>>         #2255AA
    BackgroundColor<<EventCore>>    #DDFFDD
    BorderColor<<EventCore>>        #226622
    BackgroundColor<<Transaction>>  #FFF3CC
    BorderColor<<Transaction>>      #AA7700
    BackgroundColor<<Async>>        #F5DDFF
    BorderColor<<Async>>            #7722AA
    BackgroundColor<<Redis>>        #FFE0E0
    BorderColor<<Redis>>            #CC2222
    BackgroundColor<<InMemory>>     #E0FFE0
    BorderColor<<InMemory>>         #22AA22
    HeaderBackgroundColor<<Identity>>     #2255AA
    HeaderBackgroundColor<<EventCore>>    #226622
    HeaderBackgroundColor<<Transaction>>  #AA7700
    HeaderBackgroundColor<<Async>>        #7722AA
    HeaderBackgroundColor<<Redis>>        #CC2222
    HeaderBackgroundColor<<InMemory>>     #22AA22
    HeaderFontColor white
}

' ============================================================
' BOUNDED CONTEXT 1 — IDENTITY
' Design.md ADR-02: students(student_id TEXT PK) + staff(id UUID PK)
' ============================================================
package "Identity" #EEF4FF {

    class students <<Identity>> {
        + student_id : TEXT <<PK>>
        --
        email : TEXT
        full_name : TEXT
        ~ password_hash : TEXT <<NULLABLE>>
        updated_at : TIMESTAMPTZ
    }

    class staff <<Identity>> {
        + id : UUID <<PK>>
        --
        email : TEXT <<UQ>>
        full_name : TEXT
        password_hash : TEXT
        role : staff_role
        is_active : BOOLEAN DEFAULT true
        created_at : TIMESTAMPTZ
        --
        idx: (role) WHERE is_active=true
    }
}

' ============================================================
' BOUNDED CONTEXT 2 — EVENT CORE
' Design.md ADR-02: workshops trực tiếp quản lý seats_total + seats_available
'                   Không tách bảng workshop_slots riêng
' ============================================================
package "Event Core" #EEFFEE {

    class speakers <<EventCore>> {
        + id : UUID <<PK>>
        --
        full_name : VARCHAR(255)
        title : VARCHAR(255)
        bio : TEXT
        avatar_url : VARCHAR(1000)
        created_at : TIMESTAMPTZ
        updated_at : TIMESTAMPTZ
    }

    class rooms <<EventCore>> {
        + id : UUID <<PK>>
        --
        name : VARCHAR(100)
        building : VARCHAR(100)
        floor : SMALLINT
        capacity : SMALLINT
        floor_plan_url : VARCHAR(1000)
        facilities : JSONB
        created_at : TIMESTAMPTZ
        updated_at : TIMESTAMPTZ
        --
        chk: capacity > 0
        idx: name
    }

    class workshops <<EventCore>> {
        + id : UUID <<PK>>
        --
        title : TEXT
        description : TEXT
        location : TEXT
        starts_at : TIMESTAMPTZ
        ends_at : TIMESTAMPTZ
        seats_total : INT
        seats_available : INT
        price : NUMERIC(10,2) DEFAULT 0
        status : workshop_status
        ~ created_by : UUID <<FK>>
        -- ADR-14: summary + PDF gộp trực tiếp
        pdf_url : TEXT
        summary_text : TEXT
        summary_status : summary_status
        -- ADR-03: Optimistic Lock
        version : BIGINT DEFAULT 0
        created_at : TIMESTAMPTZ
        updated_at : TIMESTAMPTZ
        --
        chk: ends_at > starts_at
        chk: seats_total > 0
        chk: seats_available >= 0 AND <= seats_total
        idx: (status, starts_at) WHERE status='OPEN'
    }
}

' ============================================================
' BOUNDED CONTEXT 3 — TRANSACTION
' Design.md ADR-02: registrations có qr_code, checkins UNIQUE(registration_id)
'                   idempotency_keys dùng chung cho ADR-03 và ADR-08
' ============================================================
package "Transaction" #FFFBEE {

    class registrations <<Transaction>> {
        + id : UUID <<PK>>
        --
        ~ workshop_id : UUID <<FK>>
        ~ student_id : TEXT <<FK>>
        status : registration_status
        qr_code : TEXT <<UQ>> -- UUID v4 độc lập
        registered_at : TIMESTAMPTZ
        --
        uq: (workshop_id, student_id)
        idx: workshop_id
        idx: student_id
        idx: qr_code
    }

    class payments <<Transaction>> {
        + id : UUID <<PK>>
        --
        ~ registration_id : UUID <<FK>>
        amount : NUMERIC(10,2)
        currency : TEXT DEFAULT 'VND'
        gateway_charge_id : TEXT
        status : payment_status
        ~ idempotency_key : TEXT <<FK>> -- REFERENCES idempotency_keys(key)
        created_at : TIMESTAMPTZ
        resolved_at : TIMESTAMPTZ
        --
        chk: amount > 0
        idx: (status, created_at) WHERE status IN ('INITIATED','UNRESOLVED')
    }

    class checkins <<Transaction>> {
        + id : UUID <<PK>>
        --
        ~ registration_id : UUID <<FK, UQ>>
        checked_in_at : TIMESTAMPTZ
        received_at : TIMESTAMPTZ
        ~ checked_by : UUID <<FK>> -- REFERENCES staff(id)
        client_local_id : TEXT
        --
        uq: registration_id -- first check-in wins
        idx: (checked_by, received_at)
    }

    class idempotency_keys <<Transaction>> {
        + key : TEXT <<PK>>
        --
        resource_type : idempotency_resource_type
        status : idempotency_status
        response_body : JSONB
        status_code : INT
        created_at : TIMESTAMPTZ
        expires_at : TIMESTAMPTZ
        locked_until : TIMESTAMPTZ
        --
        idx: expires_at
    }
}

' ============================================================
' BOUNDED CONTEXT 4 — ASYNC
' Design.md ADR-12 (import_logs), ADR-09 (notification_logs), ADR-14 (summary gộp)
' ============================================================
package "Async" #F8EEFF {

    class import_logs <<Async>> {
        + id : UUID <<PK>>
        --
        run_at : TIMESTAMPTZ
        total_rows : INT
        success_count : INT
        failed_count : INT
        error_file_path : TEXT -- errors/YYYY-MM-DD.csv
        triggered_by : import_trigger
        status : import_status
    }

    class notification_logs <<Async>> {
        + id : UUID <<PK>>
        --
        user_id : TEXT -- student_id hoặc staff.id
        event_type : notification_type
        channel : notification_channel
        status : notification_delivery_status
        error_msg : TEXT
        payload : JSONB
        created_at : TIMESTAMPTZ
        --
        idx: (status, created_at) WHERE status IN ('FAILED','TIMEOUT')
    }

    class notification_channel_configs <<Async>> {
        + id : UUID <<PK>>
        --
        channel_type : notification_channel <<UQ>>
        is_active : BOOLEAN DEFAULT TRUE
        config_json : JSONB
        created_at : TIMESTAMPTZ
        updated_at : TIMESTAMPTZ
    }
}

' ============================================================
' REDIS STRUCTURES (Cache + Rate Limiting + Streams)
' PostgreSQL là sole source of truth — Redis là auxiliary layer
' ============================================================
package "Redis (Auxiliary)" #FFF0F0 {

    class "cache:workshop:{id}:seats" <<Redis>> {
        Key: cache:workshop:{workshop_id}:seats
        Type: String (integer)
        --
        Pattern: Cache-Aside (GET/SET EX 10/DEL)
        TTL: 10s
        --
        KHÔNG phải source of truth.
        Cache miss → đọc DB → SET EX 10.
        Sau OL commit → DEL (Write-Invalidate).
        KHÔNG dùng DECR.
    }

    class "cache:workshop:list" <<Redis>> {
        Key: cache:workshop:list
        Type: String (JSON array)
        --
        TTL: 60s
    }

    class "rl:ip:{ip}" <<Redis>> {
        Key: rl:ip:{ip}
        Type: Sorted Set (Sliding Window)
        --
        Threshold: 60 req / 60s
        ZREMRANGEBYSCORE + ZADD + ZCARD + EXPIRE
    }

    class "rl:user:{uid}" <<Redis>> {
        Key: rl:user:{user_id}
        Type: Sorted Set (Sliding Window)
        --
        Threshold: 30 req / 60s
    }

    class "rl:reg:{uid}:{wid}" <<Redis>> {
        Key: rl:reg:{user_id}:{workshop_id}
        Type: Sorted Set (Sliding Window)
        --
        Threshold: 5 req / 60s
    }

    class "Queue: ai-summary" <<Redis>> {
        Key: Queue: ai-summary
        Type: BullMQ
        --
        @Processor + auto-ack
        DLQ: Queue: ai-summary-dlq
    }

    class "Queue: notification" <<Redis>> {
        Key: Queue: notification
        Type: BullMQ
        --
        @Processor + auto-ack
        DLQ: Queue: notification-dlq
    }
}

' ============================================================
' IN-MEMORY STRUCTURES (No Redis — process variables)
' ============================================================
package "In-Memory (ADR-07)" #EEFFEE {

    class "Circuit Breaker\n(payment gateway)" <<InMemory>> {
        State: CLOSED | OPEN | HALF_OPEN
        --
        Threshold: 5 failures / 60s → OPEN
        Cool-down: 30s → HALF_OPEN
        Probing: 2 consecutive success → CLOSED
        --
        Restart process = reset về CLOSED
        (design.md ADR-07 Section 5)
    }
}

' ============================================================
' RELATIONSHIPS
' ============================================================

' Identity
staff           "1" -- "0..*" workshops             : "created_by >"

' Event Core
' speakers và rooms là reference data (workshops dùng location TEXT, không FK)

' Transaction
students        "1" -- "0..*" registrations         : "registers >"
workshops       "1" -- "0..*" registrations         : "receives >"
registrations   "1" -- "0..1" payments              : "paid via >"
registrations   "1" -- "0..1" checkins              : "check-in for >"
staff           "1" -- "0..*" checkins              : "scanned by >"
idempotency_keys "1" -- "0..1" payments             : "idempotency for >"

' Async

' Redis conceptual links (dashed)
workshops       . "cache:workshop:{id}:seats"        : "cached by"

@enduml
