# ── App ──────────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development

# ── Database (Neon Serverless PostgreSQL) ────────────────────────────────────
# Both variables typically point to the same Neon connection string.
# DATABASE_URL            — used by the NestJS app at runtime (pooled).
# DATABASE_MIGRATION_URL  — used by drizzle-kit for migrations (direct session).
# Get your connection string from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_MIGRATION_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Redis ────────────────────────────────────────────────────────────────────
# ioredis-compatible URL.
# Local: redis://localhost:6379
# Upstash (free tier): rediss://default:password@host.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate RSA-2048 key pair and base64-encode each file:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -w 0 private.pem   → paste here as JWT_PRIVATE_KEY
#   base64 -w 0 public.pem    → paste here as JWT_PUBLIC_KEY
JWT_PRIVATE_KEY=base64-encoded-rsa-2048-private-key
JWT_PUBLIC_KEY=base64-encoded-rsa-2048-public-key
# Minimum 32 random characters — e.g. run: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-random-string-at-least-32-chars

# ── Cloudflare R2 Storage ────────────────────────────────────────────────────
# Used for PDF uploads (AI Summary feature). Create a free R2 bucket:
# https://developers.cloudflare.com/r2/get-started/
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=unihub-workshop
R2_PUBLIC_URL=https://pub-<hash>.r2.dev
# Max upload size in bytes (default: 50 MB)
UPLOAD_MAX_FILE_SIZE=52428800

# ── AI Summary ───────────────────────────────────────────────────────────────
# DeepSeek API — Anthropic-compatible endpoint.
# Get your key at: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
AI_SUMMARY_MODEL=deepseek-chat

# ── Payment Gateway ──────────────────────────────────────────────────────────
# Simulated in demo mode — leave empty to use mock responses.
# The circuit breaker and idempotency key mechanisms are fully active even in mock mode.
PAYMENT_GATEWAY_SECRETS=
GATEWAY_BASE_URL=
GATEWAY_API_KEY=

# ── AI Provider HTTP Client (optional override) ──────────────────────────────
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# URL of the Next.js web frontend
FRONTEND_URL=http://localhost:3000

# ── Logging ──────────────────────────────────────────────────────────────────
# Levels: error | warn | info | debug
LOG_LEVEL=info

# ── Student Sync ─────────────────────────────────────────────────────────────
# Default password assigned to newly provisioned student accounts after CSV sync.
STUDENT_DEFAULT_PASSWORD=123456789
